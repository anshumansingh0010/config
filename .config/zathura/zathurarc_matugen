# Zathura Material You Theme
set default-bg           "#121318"
set default-fg           "#e3e2e9"
set statusbar-bg        "#1e1f25"
set statusbar-fg        "#c5c6d0"
set inputbar-bg         "#292a2f"
set inputbar-fg         "#b4c5ff"

# PDF Recoloring (Dark Mode / Midnight Mode)
set recolor             "true"
set recolor-lightcolor  "rgba(18, 19, 24, 1)"
set recolor-darkcolor   "#e3e2e9"
set recolor-keephue     "true" 
