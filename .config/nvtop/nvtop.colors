# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #0c0e12
selected_bg = #161a1f
header_bg = #22262d

# Text colors
text = #e2e5ef
selected_text = #b1c8ec
header_text = #a7abb4
inactive_text = #71757e

# GPU utilization colors (gradient from low to high)
gpu_util_low = #bfe5ff
gpu_util_med = #d0f9f4
gpu_util_high = #a3afff

# Memory usage colors
memory_low = #c5e3ff
memory_med = #9ecbff
memory_high = #93bfff

# Temperature colors (cool to hot)
temp_cool = #bfe5ff
temp_warm = #d0f9f4
temp_hot = #a3afff

# Power usage colors
power_low = #bfe5ff
power_med = #e0c2f9
power_high = #b5bbf1

# Process list colors
process_normal = #e2e5ef
process_highlight = #b1c8ec
process_killed = #a3afff

# Border and separator colors
border = #71757e
separator = #444850

# Chart and graph colors
chart_line = #e5daff
chart_fill = #161a1f

# Status indicators
status_ok = #bfe5ff
status_warning = #d0f9f4
status_error = #a3afff
status_info = #93bfff
