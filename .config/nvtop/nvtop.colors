# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #1a1111
selected_bg = #271d1d
header_bg = #534342

# Text colors
text = #f1dedd
selected_text = #ffb3af
header_text = #d8c1c0
inactive_text = #a08c8b

# GPU utilization colors (gradient from low to high)
gpu_util_low = #ffd8c5
gpu_util_med = #ffede9
gpu_util_high = #ff9699

# Memory usage colors
memory_low = #ffdb94
memory_med = #f2b2f2
memory_high = #ffa1c3

# Temperature colors (cool to hot)
temp_cool = #ffd8c5
temp_warm = #ffede9
temp_hot = #ff9699

# Power usage colors
power_low = #ffd8c5
power_med = #ffbeb4
power_high = #f9aaa9

# Process list colors
process_normal = #f1dedd
process_highlight = #ffb3af
process_killed = #ff9699

# Border and separator colors
border = #a08c8b
separator = #534342

# Chart and graph colors
chart_line = #e2c28c
chart_fill = #271d1d

# Status indicators
status_ok = #ffd8c5
status_warning = #ffede9
status_error = #ff9699
status_info = #ffa1c3
