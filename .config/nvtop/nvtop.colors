# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #100d11
selected_bg = #1d181e
header_bg = #2a232c

# Text colors
text = #efe2ed
selected_text = #ddbbe4
header_text = #b3a8b2
inactive_text = #7c727c

# GPU utilization colors (gradient from low to high)
gpu_util_low = #c8e3ff
gpu_util_med = #ffecf3
gpu_util_high = #e49be4

# Memory usage colors
memory_low = #dedcff
memory_med = #d5bcff
memory_high = #d4acfd

# Temperature colors (cool to hot)
temp_cool = #c8e3ff
temp_warm = #ffecf3
temp_hot = #e49be4

# Power usage colors
power_low = #c8e3ff
power_med = #f7bce5
power_high = #e1aedc

# Process list colors
process_normal = #efe2ed
process_highlight = #ddbbe4
process_killed = #e49be4

# Border and separator colors
border = #7c727c
separator = #4d454e

# Chart and graph colors
chart_line = #ffcdd9
chart_fill = #1d181e

# Status indicators
status_ok = #c8e3ff
status_warning = #ffecf3
status_error = #e49be4
status_info = #d4acfd
