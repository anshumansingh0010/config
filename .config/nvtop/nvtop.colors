# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #100d11
selected_bg = #1d181e
header_bg = #2a242c

# Text colors
text = #ede2ee
selected_text = #d9bce6
header_text = #b2a8b3
inactive_text = #7b737d

# GPU utilization colors (gradient from low to high)
gpu_util_low = #c8e3ff
gpu_util_med = #ffecf3
gpu_util_high = #df9ce9

# Memory usage colors
memory_low = #dedcff
memory_med = #cfbdff
memory_high = #ceaeff

# Temperature colors (cool to hot)
temp_cool = #c8e3ff
temp_warm = #ffecf3
temp_hot = #df9ce9

# Power usage colors
power_low = #c8e3ff
power_med = #f4bde9
power_high = #ddafe0

# Process list colors
process_normal = #ede2ee
process_highlight = #d9bce6
process_killed = #df9ce9

# Border and separator colors
border = #7b737d
separator = #4d464f

# Chart and graph colors
chart_line = #ffd1e0
chart_fill = #1d181e

# Status indicators
status_ok = #c8e3ff
status_warning = #ffecf3
status_error = #df9ce9
status_info = #ceaeff
