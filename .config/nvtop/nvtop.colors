# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #131315
selected_bg = #1f1f21
header_bg = #44474d

# Text colors
text = #e4e2e4
selected_text = #b8c7e2
header_text = #c5c6cd
inactive_text = #8e9097

# GPU utilization colors (gradient from low to high)
gpu_util_low = #bfe5ff
gpu_util_med = #d0f9f4
gpu_util_high = #a3afff

# Memory usage colors
memory_low = #c5e3ff
memory_med = #9ecbff
memory_high = #93bfff

# Temperature colors (cool to hot)
temp_cool = #bfe5ff
temp_warm = #d0f9f4
temp_hot = #a3afff

# Power usage colors
power_low = #bfe5ff
power_med = #e0c2f9
power_high = #b5bbf1

# Process list colors
process_normal = #e4e2e4
process_highlight = #b8c7e2
process_killed = #a3afff

# Border and separator colors
border = #8e9097
separator = #44474d

# Chart and graph colors
chart_line = #ddbdd8
chart_fill = #1f1f21

# Status indicators
status_ok = #bfe5ff
status_warning = #d0f9f4
status_error = #a3afff
status_info = #93bfff
