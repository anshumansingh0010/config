# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #110d11
selected_bg = #1e181d
header_bg = #2b232b

# Text colors
text = #f0e1ec
selected_text = #e1bae0
header_text = #b4a7b1
inactive_text = #7d727b

# GPU utilization colors (gradient from low to high)
gpu_util_low = #ffd8c5
gpu_util_med = #ffedf2
gpu_util_high = #e999dd

# Memory usage colors
memory_low = #dedcff
memory_med = #dbb9ff
memory_high = #dbaaf9

# Temperature colors (cool to hot)
temp_cool = #ffd8c5
temp_warm = #ffedf2
temp_hot = #e999dd

# Power usage colors
power_low = #ffd8c5
power_med = #fbbbdf
power_high = #e5add8

# Process list colors
process_normal = #f0e1ec
process_highlight = #e1bae0
process_killed = #e999dd

# Border and separator colors
border = #7d727b
separator = #4e454d

# Chart and graph colors
chart_line = #ffcad1
chart_fill = #1e181d

# Status indicators
status_ok = #ffd8c5
status_warning = #ffedf2
status_error = #e999dd
status_info = #dbaaf9
